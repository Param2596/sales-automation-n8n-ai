      ],
      "id": "8113514e-0ed4-41fc-8c0a-e835332787a0",
      "name": "check_valid_fields"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst id = String(b.id ?? '').trim();\nconst allowed = ['Title','Phone','Company','Status'];\nconst fields = {};\nfor (const k of allowed) if (b[k] !== undefined) fields[k] = b[k];\nconst errors = [];\nif (id.length !== 15 && id.length !== 18) errors.push('invalid lead id');\nif (Object.keys(fields).length === 0) errors.push('no updatable fields');\nreturn [{ json: { id, fields, valid: errors.length === 0, errors } }];"
      },
