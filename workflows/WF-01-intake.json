    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst errors = [];\n\nfor (const f of ['name', 'email', 'company']) {\n  if (!b[f] || String(b[f]).trim() === '') errors.push(`${f} is required`);\n}\n\nconst e = String(b.email ?? '').trim();\nconst at = e.indexOf('@');\nconst domain = e.slice(at + 1);\nconst validEmail =\n  at > 0 &&\n  at === e.lastIndexOf('@') &&\n  !e.includes(' ') &&\n  domain.includes('.') &&\n  !domain.startsWith('.') &&\n  !domain.endsWith('.');\n\nif (e && !validEmail) errors.push('email is invalid');\n\nreturn [{ json: { ...b, email: e.toLowerCase(), valid: errors.length === 0, errors } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
