# Copy to .env and fill in locally. Git ignores .env.
# Leave these blank in the example. Do not commit real values.

# n8n base URL used by scripts/cli/send-test-lead.ps1
N8N_BASE_URL=

# Same value as the n8n Header Auth credential named X_API_KEY
INTAKE_KEY=

# Salesforce External Client App (Client Credentials). My Domain only, no trailing path.
# Example shape: https://your-org.my.salesforce.com
SF_MY_DOMAIN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# REST version used by the workflow HTTP Request node (currently v66.0)
SF_API_VERSION=
